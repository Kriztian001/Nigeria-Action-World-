class WorldScene3D {
  constructor() {
    this.container = document.getElementById('game-container') || document.body;
    this.scene = new THREE.Scene();
    this.scene.background = new THREE.Color(0x0f172a);
    this.scene.fog = new THREE.FogExp2(0x0f172a, 0.008);

    this.camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
    this.cameraYaw = 0;
    this.cameraPitch = 0.35;

    this.renderer = new THREE.WebGLRenderer({ antialias: true });
    this.renderer.setSize(window.innerWidth, window.innerHeight);
    this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    this.renderer.shadowMap.enabled = true;
    this.container.appendChild(this.renderer.domElement);

    this.clock = new THREE.Clock();
    this.npcs = [];
    this.vehicles = [];

    this.initLighting();
    this.initCityGrid();
    this.rebuildPlayerMesh();
    this.initNPCs();
    this.initVehicles();

    window.addEventListener('resize', () => this.onResize());
    this.animate();
  }

  initLighting() {
    const ambient = new THREE.AmbientLight(0xffffff, 0.65);
    this.scene.add(ambient);

    this.sun = new THREE.DirectionalLight(0xfffbeb, 1.1);
    this.sun.position.set(60, 100, 60);
    this.sun.castShadow = true;
    this.sun.shadow.mapSize.width = 2048;
    this.sun.shadow.mapSize.height = 2048;
    this.scene.add(this.sun);
  }

  initCityGrid() {
    // Asphalt Ground Plane
    const groundGeo = new THREE.PlaneGeometry(800, 800);
    const groundMat = new THREE.MeshStandardMaterial({ color: 0x111827, roughness: 0.8 });
    const ground = new THREE.Mesh(groundGeo, groundMat);
    ground.rotation.x = -Math.PI / 2;
    ground.receiveShadow = true;
    this.scene.add(ground);

    // Build Realistic Street Network & Colored Buildings
    const colors = [0xef4444, 0x3b82f6, 0x10b981, 0xf59e0b, 0x8b5cf6, 0xec4899];
    
    for (let x = -200; x <= 200; x += 60) {
      for (let z = -200; z <= 200; z += 60) {
        if (Math.abs(x) < 20 && Math.abs(z) < 20) continue; // Spawn plaza center

        const height = 12 + Math.random() * 28;
        const bGeo = new THREE.BoxGeometry(36, height, 36);
        const bMat = new THREE.MeshStandardMaterial({
          color: colors[Math.floor(Math.random() * colors.length)],
          roughness: 0.4
        });
        const building = new THREE.Mesh(bGeo, bMat);
        building.position.set(x, height / 2, z);
        building.castShadow = true;
        building.receiveShadow = true;
        this.scene.add(building);

        // Streetlamp Next to Building Block
        this.createStreetLamp(x + 22, z + 22);
      }
    }
  }

  createStreetLamp(x, z) {
    const group = new THREE.Group();
    const poleGeo = new THREE.CylinderGeometry(0.15, 0.2, 7, 8);
    const poleMat = new THREE.MeshStandardMaterial({ color: 0x334155 });
    const pole = new THREE.Mesh(poleGeo, poleMat);
    pole.position.y = 3.5;

    const lampGeo = new THREE.SphereGeometry(0.4, 8, 8);
    const lampMat = new THREE.MeshBasicMaterial({ color: 0xfef08a });
    const lamp = new THREE.Mesh(lampGeo, lampMat);
    lamp.position.y = 7;

    const spot = new THREE.PointLight(0xfef08a, 0.8, 15);
    spot.position.y = 6.8;

    group.add(pole, lamp, spot);
    group.position.set(x, 0, z);
    this.scene.add(group);
  }

  rebuildPlayerMesh() {
    if (this.playerGroup) this.scene.remove(this.playerGroup);

    this.playerGroup = new THREE.Group();

    // Body Body Geometry
    const bodyGeo = new THREE.CylinderGeometry(0.35, 0.35, 1.2, 12);
    const bodyMat = new THREE.MeshStandardMaterial({ color: userStats.outfitColor || 0x38bdf8 });
    const body = new THREE.Mesh(bodyGeo, bodyMat);
    body.position.y = 0.9;
    body.castShadow = true;

    // Head Head
    const headGeo = new THREE.SphereGeometry(0.3, 16, 16);
    const headMat = new THREE.MeshStandardMaterial({ color: 0x7c2d12 });
    const head = new THREE.Mesh(headGeo, headMat);
    head.position.y = 1.7;

    // Hair Style
    if (userStats.hairStyle !== 'buzz') {
      const hairGeo = userStats.hairStyle === 'afro' ? new THREE.SphereGeometry(0.36, 12, 12) : new THREE.BoxGeometry(0.55, 0.2, 0.55);
      const hairMat = new THREE.MeshStandardMaterial({ color: 0x09090b });
      const hair = new THREE.Mesh(hairGeo, hairMat);
      hair.position.y = 1.85;
      this.playerGroup.add(hair);
    }

    this.playerGroup.add(body, head);
    this.playerGroup.position.set(0, 0, 0);
    this.scene.add(this.playerGroup);
  }

  initNPCs() {
    for (let i = 0; i < 15; i++) {
      const npcGroup = new THREE.Group();
      const body = new THREE.Mesh(
        new THREE.CylinderGeometry(0.35, 0.35, 1.2, 12),
        new THREE.MeshStandardMaterial({ color: Math.random() > 0.5 ? 0xef4444 : 0x10b981 })
      );
      body.position.y = 0.9;
      npcGroup.add(body);

      const x = (Math.random() - 0.5) * 120;
      const z = (Math.random() - 0.5) * 120;
      npcGroup.position.set(x, 0, z);

      this.scene.add(npcGroup);
      this.npcs.push({ group: npcGroup, health: 100 });
    }
  }

  initVehicles() {
    // Detailed Realistic Car Body
    const carGroup = new THREE.Group();
    const chassis = new THREE.Mesh(
      new THREE.BoxGeometry(2.2, 0.9, 4.4),
      new THREE.MeshStandardMaterial({ color: 0x0284c7, metalness: 0.5, roughness: 0.2 })
    );
    chassis.position.y = 0.6;

    const cabin = new THREE.Mesh(
      new THREE.BoxGeometry(1.8, 0.7, 2.2),
      new THREE.MeshStandardMaterial({ color: 0x0f172a })
    );
    cabin.position.set(0, 1.3, -0.2);

    // Vehicle Headlights
    const lightL = new THREE.SpotLight(0xffffff, 2, 20, Math.PI / 6);
    lightL.position.set(-0.8, 0.7, 2.2);
    lightL.target.position.set(-0.8, 0, 10);

    const lightR = lightL.clone();
    lightR.position.x = 0.8;
    lightR.target.position.x = 0.8;

    carGroup.add(chassis, cabin, lightL, lightR, lightL.target, lightR.target);
    carGroup.position.set(12, 0, 12);

    this.scene.add(carGroup);
    this.vehicles.push({ group: carGroup, speed: 0 });
  }

  punchAction() {
    if (!this.playerGroup) return;

    // Visual Punch Animation Bump
    this.playerGroup.position.y += 0.2;
    setTimeout(() => { this.playerGroup.position.y = 0; }, 120);

    // Check hit nearby NPCs and add recoil reaction
    this.npcs.forEach(npc => {
      const dist = this.playerGroup.position.distanceTo(npc.group.position);
      if (dist < 2.5) {
        npc.health -= 25;
        // Shake NPC back in reaction
        npc.group.position.x += Math.sin(this.playerGroup.rotation.y) * 0.8;
        npc.group.position.z += Math.cos(this.playerGroup.rotation.y) * 0.8;

        speakCharacter("Hey! What is your problem?!", "Pedestrian");
      }
    });
  }

  updateCameraOrbit() {
    if (!this.playerGroup) return;

    const dist = 7.5;
    const px = this.playerGroup.position.x - Math.sin(this.cameraYaw) * Math.cos(this.cameraPitch) * dist;
    const py = this.playerGroup.position.y + Math.sin(this.cameraPitch) * dist + 1.2;
    const pz = this.playerGroup.position.z - Math.cos(this.cameraYaw) * Math.cos(this.cameraPitch) * dist;

    this.camera.position.set(px, py, pz);
    this.camera.lookAt(this.playerGroup.position.x, this.playerGroup.position.y + 1.2, this.playerGroup.position.z);
  }

  onResize() {
    this.camera.aspect = window.innerWidth / window.innerHeight;
    this.camera.updateProjectionMatrix();
    this.renderer.setSize(window.innerWidth, window.innerHeight);
  }

  animate() {
    requestAnimationFrame(() => this.animate());
    const delta = this.clock.getDelta();

    // Walking & Sprinting Logic mapped to Touch Controller + Dynamic Camera Facing
    if (window.moveAngle !== null && this.playerGroup && !userStats.inVehicle) {
      const speed = (window.isSprinting ? 9.5 : 4.5) * delta;
      
      const moveHeading = window.moveAngle + this.cameraYaw;
      const dx = Math.cos(moveHeading) * speed;
      const dz = Math.sin(moveHeading) * speed;

      this.playerGroup.position.x += dx;
      this.playerGroup.position.z += dz;
      this.playerGroup.rotation.y = -moveHeading + Math.PI / 2;
    }

    this.updateCameraOrbit();
    this.renderer.render(this.scene, this.camera);
  }
}
