});

function startLoading() {
  let progress = 0;
  const fill = document.getElementById('loader-fill');
  const statusText = document.getElementById('loader-status-text');

  const timer = setInterval(() => {
    progress += 20;
    fill.style.width = `${progress}%`;
    statusText.innerText = `Loading 3D Engine Systems ${progress}%`;

    if (progress >= 100) {
      clearInterval(timer);
      setTimeout(() => {
        document.getElementById('loader-overlay').style.display = 'none';
        game3D = new WorldScene3D();
      }, 300);
    }
  }, 120);
}

function setupTouchControls() {
  const touchpad = document.getElementById('touch-touchpad');
  const base = document.getElementById('analog-base');
  const stick = document.getElementById('analog-stick');
  let touchId = null, startX = 0, startY = 0;

  touchpad.addEventListener('touchstart', (e) => {
    e.preventDefault();
    const t = e.changedTouches[0];
    touchId = t.identifier;
    startX = t.clientX; startY = t.clientY;

    base.style.display = 'block';
    base.style.left = startX + 'px'; base.style.top = startY + 'px';
  }, { passive: false });

  touchpad.addEventListener('touchmove', (e) => {
    e.preventDefault();
    for (let i = 0; i < e.changedTouches.length; i++) {
      const t = e.changedTouches[i];
      if (t.identifier === touchId) {
        const dx = t.clientX - startX;
        const dy = t.clientY - startY;
        const dist = Math.min(Math.hypot(dx, dy), 45);
        const angle = Math.atan2(dy, dx);

        window.moveAngle = angle;
        stick.style.transform = `translate(calc(-50% + ${Math.cos(angle) * dist}px), calc(-50% + ${Math.sin(angle) * dist}px))`;
      }
    }
  }, { passive: false });

  const resetAnalog = () => {
    touchId = null; window.moveAngle = null;
    base.style.display = 'none';
  };

  touchpad.addEventListener('touchend', resetAnalog);
  touchpad.addEventListener('touchcancel', resetAnalog);

  document.getElementById('btn-sprint').addEventListener('pointerdown', () => { window.isSprinting = !window.isSprinting; });
  document.getElementById('btn-punch').addEventListener('pointerdown', () => {
    if (game3D && game3D.npcs.length > 0) {
      // Attack nearest NPC
      const target = game3D.npcs[0];
      game3D.aiSystem.onEntityAttacked(target, game3D.playerMesh);
    }
  });
}
