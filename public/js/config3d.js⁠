function speakCharacter(text, speaker = 'Citizen') {
  const subtitleBox = document.getElementById('dialogue-subtitle');
  if (subtitleBox) {
    subtitleBox.innerText = `${speaker}: "${text}"`;
    subtitleBox.style.display = 'block';
    setTimeout(() => { subtitleBox.style.display = 'none'; }, 3500);
  }

  if (gameSettings.audioEnabled && 'speechSynthesis' in window) {
    try {
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.rate = 1.0;
      utterance.pitch = speaker === 'Player' ? 0.9 : 1.1;
      window.speechSynthesis.speak(utterance);
    } catch (err) {
      console.warn("Speech synthesis blocked or unavailable");
    }
  }
}

function updateHUD() {
  const cashText = document.getElementById('hud-cash-text');
  const healthBar = document.getElementById('hud-health-bar');
  const armorBar = document.getElementById('hud-armor-bar');
  const wantedText = document.getElementById('hud-wanted-text');

  if (cashText) cashText.innerText = `₦${userStats.cash.toLocaleString()}`;
  if (healthBar) healthBar.style.width = `${Math.max(0, userStats.health)}%`;
  if (armorBar) armorBar.style.width = `${Math.max(0, userStats.armor)}%`;
  if (wantedText) {
    wantedText.innerText = userStats.wantedLevel > 0 ? '★'.repeat(userStats.wantedLevel) : '';
  }
}

function openCustomization() {
  const modal = document.getElementById('customization-overlay');
  if (modal) modal.style.display = 'flex';
}

function closeCustomization() {
  const modal = document.getElementById('customization-overlay');
  if (modal) modal.style.display = 'none';
