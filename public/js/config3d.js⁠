function startLoading() {
  let progress = 0;
  const fill = document.getElementById('loader-fill');
  const statusText = document.getElementById('loader-status-text');

  const timer = setInterval(() => {
    progress += 20;
    if (fill) fill.style.width = `${progress}%`;
    if (statusText) statusText.innerText = `Loading Street Assets & Audio Engine ${progress}%`;

    if (progress >= 100) {
      clearInterval(timer);
      setTimeout(() => {
        document.getElementById('loader-overlay').style.display = 'none';
        document.getElementById('hud-container').style.display = 'flex';
        document.getElementById('top-bar').style.display = 'flex';
        document.getElementById('action-buttons').style.display = 'flex';

        game3D = new WorldScene3D();
      }, 300);
    }
  }, 100);
}

function setupTouchAndCameraControls() {
  const touchpad = document.getElementById('touch-touchpad');
  const dragzone = document.getElementById('camera-dragzone');
  const base = document.getElementById('analog-base');
  const stick = document.getElementById('analog-stick');

  let moveTouchId = null, startX = 0, startY = 0;
  let camTouchId = null, lastCamX = 0, lastCamY = 0;

  // Touch Movement Joystick
  touchpad.addEventListener('touchstart', (e) => {
    e.preventDefault();
    const t = e.changedTouches[0];
    moveTouchId = t.identifier;
    startX = t.clientX; startY = t.clientY;

    base.style.display = 'block';
    base.style.left = startX + 'px';
    base.style.top = startY + 'px';
  }, { passive: false });

  touchpad.addEventListener('touchmove', (e) => {
    e.preventDefault();
    for (let i = 0; i < e.changedTouches.length; i++) {
      const t = e.changedTouches[i];
      if (t.identifier === moveTouchId) {
        const dx = t.clientX - startX;
        const dy = t.clientY - startY;
        const dist = Math.min(Math.hypot(dx, dy), 45);
        const angle = Math.atan2(dy, dx);

        window.moveAngle = angle;
        stick.style.transform = `translate(calc(-50% + ${Math.cos(angle) * dist}px), calc(-50% + ${Math.sin(angle) * dist}px))`;
      }
    }
  }, { passive: false });

  const resetAnalog = () => {
    moveTouchId = null; window.moveAngle = null;
    base.style.display = 'none';
  };
  touchpad.addEventListener('touchend', resetAnalog);
  touchpad.addEventListener('touchcancel', resetAnalog);

  // 360 Camera Touch Dragging
  dragzone.addEventListener('touchstart', (e) => {
    const t = e.changedTouches[0];
    camTouchId = t.identifier;
    lastCamX = t.clientX;
    lastCamY = t.clientY;
  });

  dragzone.addEventListener('touchmove', (e) => {
    for (let i = 0; i < e.changedTouches.length; i++) {
      const t = e.changedTouches[i];
      if (t.identifier === camTouchId && game3D) {
        const dx = t.clientX - lastCamX;
        const dy = t.clientY - lastCamY;
        game3D.cameraYaw -= dx * 0.006;
        game3D.cameraPitch = Math.max(0.1, Math.min(Math.PI / 2.5, game3D.cameraPitch + dy * 0.005));

        lastCamX = t.clientX;
        lastCamY = t.clientY;
      }
    }
  });

  document.getElementById('btn-sprint').addEventListener('pointerdown', () => {
    window.isSprinting = !window.isSprinting;
  });

  document.getElementById('btn-punch').addEventListener('pointerdown', () => {
    if (game3D) game3D.punchAction();
  });
}
