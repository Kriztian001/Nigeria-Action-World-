function updatePlayerAppearance() {
  const genderEl = document.getElementById('cust-gender');
  const hairEl = document.getElementById('cust-hair');
  const colorEl = document.getElementById('cust-color');

  if (genderEl) userStats.gender = genderEl.value;
  if (hairEl) userStats.hairStyle = hairEl.value;
  if (colorEl) userStats.outfitColor = colorEl.value;

