const http = require('http');
const fs = require('fs');
const path = require('path');

const PORT = process.env.PORT || 10000;

// LOG ALL FILES ON STARTUP
console.log("=== ROOT DIRECTORY CONTENTS (__dirname) ===");
try {
  console.log(fs.readdirSync(__dirname));
} catch (e) {
  console.log("Error reading __dirname:", e);
}

console.log("=== PUBLIC FOLDER CONTENTS ===");
try {
  const publicPath = path.join(__dirname, 'public');
  console.log(fs.readdirSync(publicPath));
} catch (e) {
  console.log("Error reading public folder:", e.message);
}

const MIME_TYPES = {
  '.html': 'text/html',
  '.js': 'text/javascript',
  '.css': 'text/css',
  '.json': 'application/json',
  '.png': 'image/png',
  '.jpg': 'image/jpeg',
  '.ico': 'image/x-icon'
};

const server = http.createServer((req, res) => {
  let reqPath = req.url.split('?')[0];
  let cleanName = reqPath === '/' ? 'index.html' : reqPath.replace(/^\/+/, '');
  
  // Search order: public/file -> root/file
  let possiblePaths = [
    path.join(__dirname, 'public', cleanName),
    path.join(__dirname, cleanName)
  ];

  let foundPath = possiblePaths.find(p => fs.existsSync(p) && !fs.statSync(p).isDirectory());

  if (foundPath) {
    let extname = String(path.extname(foundPath)).toLowerCase();
    let contentType = MIME_TYPES[extname] || 'application/octet-stream';
    res.writeHead(200, { 'Content-Type': contentType });
    fs.createReadStream(foundPath).pipe(res);
  } else {
    res.writeHead(404, { 'Content-Type': 'text/plain' });
    res.end(`File not found: ${cleanName}. Checked paths: ${possiblePaths.join(' AND ')}`);
  }
});

server.listen(PORT, () => {
  console.log(`Server running on port ${PORT}`);
});
